;; Kago appview frontend — reagent + re-frame, rendered with jp-go-dds
;; (デジタル庁デザインシステム). Migrated from
;; appview/etzhayyim-wasm-kago-ride-y83jjx4l/svelte (Svelte 5 + Vite 6).
;;
;; reagent/re-frame/clojurescript/shadow-cljs live under the :cljs alias
;; rather than top-level :deps (workspace convention — the
;; jvm-new-surface-guard hook, ADR-2608201300, denies new top-level JVM
;; runtime deps; see orgs/kotoba-lang/kami-genko/deps.edn and
;; orgs/kotoba-lang/plm/deps.edn for the same shape). jp-go-dds is a
;; workspace git dep and stays top-level.
{:paths ["src"]
 :deps {org.clojure/clojure {:mvn/version "1.12.0"}
        io.github.kotoba-lang/jp-go-digital-design-system
        {:git/url "https://github.com/kotoba-lang/jp-go-digital-design-system.git"
         :git/sha "dc4602dc17bce8f6e9ba038e92b3e95fcc411b49"}}
 :aliases {:cljs {:extra-deps {org.clojure/clojurescript {:mvn/version "1.11.132"}
                                thheller/shadow-cljs {:mvn/version "2.28.20"}
                                reagent/reagent {:mvn/version "1.2.0"}
                                re-frame/re-frame {:mvn/version "1.4.3"}}}
           :test {:extra-paths ["test"]}}}
